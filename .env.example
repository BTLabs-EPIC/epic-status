# epic-status configuration — copy to `.env` (gitignored) or put the same lines in a
# systemd EnvironmentFile. Every variable is optional; the values shown are the defaults.
#
#   cp .env.example .env
#
# Never commit a filled-in copy: ADMIN_PASSWORD_HASH and PROBER_KEYS are secrets.

# --- Where it listens. Keep loopback and put nginx in front.
EPIC_STATUS_BIND=127.0.0.1
EPIC_STATUS_PORT=13431

# --- State. Use absolute paths when running under systemd.
EPIC_STATUS_DB=./data/status.db
EPIC_STATUS_TARGETS_FILE=./config/targets.toml

# --- How the instance names itself.
EPIC_STATUS_SITE_NAME="Epic Cash Status"
EPIC_STATUS_SITE_URL=https://status.example.org
# Footer "Source" / "Run your own" links. Point it at your fork if you change the code.
EPIC_STATUS_SOURCE_URL=https://github.com/blacktyger/epic-status
# Stamped on every stored check, and shown as the vantage point in the footer.
EPIC_STATUS_PROBER_ID=local
EPIC_STATUS_PROBER_REGION=unknown

# --- Your own Epic node (optional). Add it to config/targets.toml as well, with
# `ours = true`; this URL additionally lets the board time it from the reader's browser.
# EPIC_STATUS_OWN_NODE_URL=https://node.example.org

# --- Released node/wallet versions, read from GitHub every 3 h in the background.
EPIC_STATUS_RELEASE_CHECK=true
# Pin instead of fetching:
# EPIC_STATUS_RELEASED_NODE_VERSION=4.1.0

# --- Public features. Turn both off if the service is reachable without a proxy.
EPIC_STATUS_SUBMISSIONS_ENABLED=true
EPIC_STATUS_QUICKCHECK_ENABLED=true
# Never true on a host that also runs an Epic node: Epic bans peers by IP, so a failed
# probe handshake gets your own node banned by the remote for three hours.
EPIC_STATUS_QUICKCHECK_P2P_HANDSHAKE=false
# Public addresses of this machine that are not on any interface (1:1 NAT, elastic IP).
# EPIC_STATUS_QUICKCHECK_EXTRA_SELF_ADDRESSES=203.0.113.10

# --- Admin dashboard. Empty hash = /admin does not exist.
# Generate with: uv run epic-status admin-password
EPIC_STATUS_ADMIN_USER=admin
EPIC_STATUS_ADMIN_PASSWORD_HASH=
# false only for plain-HTTP local development.
EPIC_STATUS_ADMIN_COOKIE_SECURE=true

# --- Remote probers, id:secret,… — generate with: uv run epic-status prober-key <id>
EPIC_STATUS_PROBER_KEYS=

# --- Tuning.
EPIC_STATUS_KEEP_SUCCESS_DAYS=7
EPIC_STATUS_MAX_CONCURRENCY=16
EPIC_STATUS_HTTP_TIMEOUT_S=4.0
EPIC_STATUS_WS_TIMEOUT_S=8.0

# Development only — disables the SSRF guards. Never on a public instance.
EPIC_STATUS_ALLOW_PRIVATE_TARGETS=false
